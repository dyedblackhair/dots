{
  "layer": "top",
  "position": "top",
  "spacing": 3,
  "height": 1,
  "margin-top": 7,
  "margin-left": 400,
  "margin-right": 400,

  "modules-left": ["mango/workspaces", "mango/layout"],
  "modules-center": ["mpris"],

  "modules-right": [
    "network",
    "wireplumber",
    "backlight",
    "battery",
    "clock",
    "mango/language",
    "tray",
    "custom/tray-menu",
    "custom/notification",
    "custom/lock",
    "custom/power"
  ],

  "custom/notification": {
    "format": "{}",
    "return-type": "json",
    "interval": 1,
    "exec": "@HOME@/.config/waybar/scripts/notifications.sh",
    "tooltip": true,
    "on-click": "dunstctl close-all",
    "on-click-right": "dunstctl set-paused toggle",
    "on-click-middle": "dunstctl history-pop"
  },

  "custom/lock": {
    "format": "<span font_family='Font Awesome 6 Free, Font Awesome 7 Free' font_weight='900'>\uf023</span>",
    "tooltip": false,
    "on-click": "swaylock -f -c 000000"
  },

  "custom/power": {
    "format": "<span font_family='Font Awesome 6 Free, Font Awesome 7 Free' font_weight='900'>\uf011</span>",
    "tooltip": false,
    "on-click": "@HOME@/.config/waybar/scripts/power-menu.sh"
  },

  "mango/workspaces": {
    "format": "{icon}",
    "on-click": "activate",
    "hide-empty": true,
    "format-icons": {
      "default": "○",
      "active": "●",
      "urgent": "●"
    }
  },

  "mango/layout": {
    "format": "{}"
  },

  "mango/language": {
    "format": "<span font_family='Font Awesome 6 Free, Font Awesome 7 Free' font_weight='900'>\uf0ac</span> {short}"
  },

  "mpris": {
    "format": "<span font_family='Font Awesome 6 Free, Font Awesome 7 Free' font_weight='900'>\uf04c</span> {artist} - {title} ",
    "format-paused": "<span font_family='Font Awesome 6 Free, Font Awesome 7 Free' font_weight='900'>\uf04b</span> {artist} - {title} ",
    "max-length": 60,
    "tooltip": true,
    "player": "spotify"
  },

  "tray": {
    "icon-size": 16,
    "spacing": 6,
    "show-passive-items": true
  },

  "custom/tray-menu": {
    "format": "<span font_family='Font Awesome 6 Free, Font Awesome 7 Free' font_weight='900'>\uf0c9</span>",
    "tooltip": false,
    "on-click": "@HOME@/.config/waybar/scripts/tray-menu.py"
  },

  "network": {
    "interval": 3,
    "format-wifi": "<span font_family='Font Awesome 6 Free, Font Awesome 7 Free' font_weight='900'>\uf1eb</span> {signalStrength}%",
    "format-ethernet": "<span font_family='Font Awesome 6 Free, Font Awesome 7 Free' font_weight='900'>\uf6ff</span> {ifname}",
    "format-linked": "<span font_family='Font Awesome 6 Free, Font Awesome 7 Free' font_weight='900'>\uf6ff</span> {ifname}",
    "format-disconnected": "<span font_family='Font Awesome 6 Free, Font Awesome 7 Free' font_weight='900'>\uf071</span>",
    "tooltip-format": "{ifname}\n{ipaddr}/{cidr}\n{essid}\n{signalStrength}%",
    "on-click": "kitty -e nmtui"
  },

  "wireplumber": {
    "scroll-step": 5,
    "format": "{icon} {volume}%",
    "format-muted": "<span font_family='Font Awesome 6 Free, Font Awesome 7 Free' font_weight='900'>\uf026</span> muted",
    "on-click": "pavucontrol",
    "format-icons": {
      "default": [
        "<span font_family='Font Awesome 6 Free, Font Awesome 7 Free' font_weight='900'>\uf026</span>",
        "<span font_family='Font Awesome 6 Free, Font Awesome 7 Free' font_weight='900'>\uf027</span>",
        "<span font_family='Font Awesome 6 Free, Font Awesome 7 Free' font_weight='900'>\uf028</span>"
      ],
      "headphones": "<span font_family='Font Awesome 6 Free, Font Awesome 7 Free' font_weight='900'>\uf025</span>",
      "headset": "<span font_family='Font Awesome 6 Free, Font Awesome 7 Free' font_weight='900'>\uf590</span>"
    }
  },

  "backlight": {
    "format": "<span font_family='Font Awesome 6 Free, Font Awesome 7 Free' font_weight='900'>\uf185</span> {percent}%",
    "scroll-step": 5
  },

  "battery": {
    "interval": 30,
    "states": {
      "warning": 30,
      "critical": 15
    },
    "format": "{icon} {capacity}%",
    "format-charging": "<span font_family='Font Awesome 6 Free, Font Awesome 7 Free' font_weight='900'>\uf0e7</span> {capacity}%",
    "format-plugged": "<span font_family='Font Awesome 6 Free, Font Awesome 7 Free' font_weight='900'>\uf0e7</span> {capacity}%",
    "tooltip-format": "{timeTo}\n{capacity}%",
    "format-icons": [
      "<span font_family='Font Awesome 6 Free, Font Awesome 7 Free' font_weight='900'>\uf244</span>",
      "<span font_family='Font Awesome 6 Free, Font Awesome 7 Free' font_weight='900'>\uf244</span>",
      "<span font_family='Font Awesome 6 Free, Font Awesome 7 Free' font_weight='900'>\uf243</span>",
      "<span font_family='Font Awesome 6 Free, Font Awesome 7 Free' font_weight='900'>\uf243</span>",
      "<span font_family='Font Awesome 6 Free, Font Awesome 7 Free' font_weight='900'>\uf242</span>",
      "<span font_family='Font Awesome 6 Free, Font Awesome 7 Free' font_weight='900'>\uf242</span>",
      "<span font_family='Font Awesome 6 Free, Font Awesome 7 Free' font_weight='900'>\uf241</span>",
      "<span font_family='Font Awesome 6 Free, Font Awesome 7 Free' font_weight='900'>\uf241</span>",
      "<span font_family='Font Awesome 6 Free, Font Awesome 7 Free' font_weight='900'>\uf240</span>",
      "<span font_family='Font Awesome 6 Free, Font Awesome 7 Free' font_weight='900'>\uf240</span>"
    ]
  },

  "clock": {
    "format": "<span font_family='Font Awesome 6 Free, Font Awesome 7 Free' font_weight='900'>\uf017</span> {:%H:%M}",
    "tooltip-format": "<span font_family='Font Awesome 6 Free, Font Awesome 7 Free' font_weight='900'>\uf073</span> {:%A, %d %B %Y}"
  }
}
