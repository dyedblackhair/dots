{
  "layer": "top",
  "position": "top",
  "spacing": 3,
  "height": 1,
  "margin-top": 7,
  "margin-left": 400,
  "margin-right": 400,

  "modules-left": ["mango/workspaces","mango/layout"],
  "modules-center": ["mpris"],

  "modules-right": [
    "wireplumber",
    "backlight",
    "battery",
    "clock",
    "mango/language",
    "custom/notification",
    "custom/lock",
    "custom/power"
  ],

  "custom/tab": {
    "format": "[Z]",
    "on-click": "rofi -show drun"
  },

  "custom/notification": {
    "format": "{}",
    "return-type": "json",
    "interval": 1,
    "exec": "@HOME@/.config/waybar/scripts/notifications.sh",
    "tooltip": true,
    "on-click": "dunstctl close-all",
    "on-click-right": "dunstctl set-paused toggle",
    "on-click-middle": "dunstctl history-pop"
  },

  "custom/power": {
    "format": " ",
    "tooltip": false,
    "on-click": "@HOME@/.config/waybar/scripts/power-menu.sh"
  },

  "mango/workspaces": {
    "format": "{icon}",
    "on-click": "activate",
    "hide-empty": true,
    "format-icons": {
      "default": "○",
      "active": "●",
      "urgent": "●"
    }
  },

  "mango/layout": {
	"format": "{}"
  },
  
  "mango/language": {
  	"format": "{short}"
  },

  "mpris": {
    "format": " {artist} - {title} ",
    "format-paused": "󰐊 {artist} - {title} ",
    "max-length": 60,
    "tooltip": true,
    "player": "spotify"
  },

  "tray": {
    "icon-size": 16,
    "spacing": 6
  },

  "wireplumber": {
    "scroll-step": 5,
    "format": "{icon} {volume}%",
    "format-muted": "󰝟 muted",
    "on-click": "pavucontrol",
    "format-icons": {
      "default": ["󰕿", "󰖀", "󰕾"],
      "headphones": "󰋋",
      "headset": "󰋎"
    }
  },

  "clock": {
    "format": "{:%H:%M}"
  },

  /*"custom/lock": {
    "format": " ",
    "on-click": "pkill -u $USER",
    "tooltip": true,
    "tooltip-format": "Lock Screen"
  }*/
}
