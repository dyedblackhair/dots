# Generated by matugen from the current wallpaper. Dark palette only.
# Do not edit by hand - change templates/dunst in ~/.config/matugen.

[global]
    monitor = 0
    follow = mouse

    width = 360
    height = (0, 300)
    origin = top-right
    offset = (12, 48)
    scale = 0
    notification_limit = 5

    progress_bar = true
    progress_bar_height = 8
    progress_bar_frame_width = 1
    progress_bar_min_width = 150
    progress_bar_max_width = 300
    progress_bar_corner_radius = 4

    indicate_hidden = yes
    transparency = 0
    separator_height = 0
    padding = 12
    horizontal_padding = 14
    text_icon_padding = 8
    frame_width = 2
    frame_color = "{{ colors.outline_variant.default.hex }}"
    gap_size = 8
    separator_color = frame
    sort = yes
    idle_threshold = 120

    font = JetBrains Mono 10
    line_height = 4
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    show_age_threshold = 60
    ellipsize = middle
    ignore_newline = no
    stack_duplicates = true
    hide_duplicate_count = false
    show_indicators = yes

    enable_recursive_icon_lookup = true
    icon_theme = Adwaita
    icon_position = left
    min_icon_size = 24
    max_icon_size = 48

    sticky_history = yes
    history_length = 30

    dmenu = /usr/bin/rofi -dmenu -p dunst:
    browser = /usr/bin/xdg-open
    always_run_script = true
    title = Dunst
    class = Dunst

    corner_radius = 12
    corners = all
    ignore_dbusclose = false
    force_xwayland = false

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[experimental]
    per_monitor_dpi = false
    pause_on_mouse_over = true

[urgency_low]
    background = "#{{ colors.surface_container_low.default.hex_stripped }}e6"
    foreground = "#{{ colors.on_surface_variant.default.hex_stripped }}"
    frame_color = "#{{ colors.outline_variant.default.hex_stripped }}"
    timeout = 5
    default_icon = dialog-information-symbolic

[urgency_normal]
    background = "#{{ colors.surface_container_high.default.hex_stripped }}e6"
    foreground = "#{{ colors.on_surface.default.hex_stripped }}"
    frame_color = "#{{ colors.primary.default.hex_stripped }}"
    timeout = 8
    default_icon = dialog-information-symbolic

[urgency_critical]
    background = "#{{ colors.error_container.default.hex_stripped }}f2"
    foreground = "#{{ colors.on_error_container.default.hex_stripped }}"
    frame_color = "#{{ colors.error.default.hex_stripped }}"
    timeout = 0
    default_icon = dialog-warning-symbolic
